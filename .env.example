# ============================================================================
# IMMY & EMY — variabile de mediu (§61)
#
# Copiază fișierul în `.env.local` și completează valorile.
# `.env.local` este în .gitignore: NICIUN secret nu ajunge în depozit.
#
# Platforma pornește și fără cele mai multe dintre ele. Ce lipsește dezactivează
# funcția respectivă în mod vizibil, nu în tăcere: panoul din
# /admin/impostazioni arată exact ce este configurat și ce nu.
# ============================================================================

# --- OBLIGATORIU: baza de date și autentificarea ----------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheia de service ocolește RLS. NU o pune niciodată într-o variabilă
# NEXT_PUBLIC_*: ar ajunge în bundle-ul de browser și ar da oricui acces la
# toate datele. Rămâne exclusiv pe server.
SUPABASE_SERVICE_ROLE_KEY=

# Șirul de conexiune direct la Postgres, folosit DOAR de scriptul de migrare.
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=

# --- Adresa publică ---------------------------------------------------------
# Apare în linkurile din e-mailuri, în sitemap și în datele structurate.
# Pe Vercel se deduce singură; în local, lasă-o goală.
IMMY_SITE_URL=

# --- E-mail (§29) -----------------------------------------------------------
# Fără cheie, notificările rămân în aplicație, marcate ca netrimise.
EMAIL_API_KEY=
EMAIL_FROM="IMMY & EMY <noreply@immyemy.it>"

# --- Telegram pentru administratori (§31) -----------------------------------
# Botul se creează cu @BotFather. `TELEGRAM_CHAT_ID` este grupul sau contul
# care primește avertizările; îl afli scriind botului și deschizând
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Business (§30) ------------------------------------------------
# Adaptorul este pregătit; canalul se activează când cheile există.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Asistent (§44) ---------------------------------------------------------
# Fără cheie asistentul funcționează oricum: răspunde citând baza de cunoștințe
# și FAQ-ul. Cu cheie, formulează mai natural — dar tot numai din ce găsește.
ANTHROPIC_API_KEY=
IMMY_AI_MODEL=claude-sonnet-5

# --- Remindere automate (§28) ----------------------------------------------
# Secret propriu, generat de tine: `openssl rand -hex 32`.
# Fără el, /api/cron/promemoria refuză orice cerere.
IMMY_CRON_SECRET=

# Fereastra de căutare, în minute. TREBUIE să fie cât intervalul dintre rulări:
#   cron orar  → 60   (implicit; merge și reminderul de 2 ore)
#   cron zilnic → 1440 (planul Hobby al Vercel permite doar o rulare pe zi)
IMMY_CRON_WINDOW_MINUTES=1440

# --- Plăți (§43) ------------------------------------------------------------
# Infrastructura există; plata online rămâne închisă până când o pornești și
# din /admin/impostazioni.
STRIPE_SECRET_KEY=
PAYPAL_SECRET=

# --- Reglaje fine (opționale) ----------------------------------------------
# Bucket-ul privat al documentelor și durata linkurilor semnate, în secunde.
IMMY_STORAGE_BUCKET=ie-documenti
IMMY_SIGNED_URL_TTL=120

# Parola conturilor demo create de scripts/seed-demo.mjs.
IMMY_DEMO_PASSWORD=
